# ==============================================================================
# SMART QR PRINT - ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT store real production secrets in this file or commit .env to source control.
# ==============================================================================

# Node Environment & Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/v1

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://smartqr:smartqr_secret@localhost:5432/smart_qr_print?schema=public

# Redis Cache & BullMQ Queue
REDIS_URL=redis://:redis_secret@localhost:6379/0

# Supabase Auth & Secure Object Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
STORAGE_BUCKET=smart-qr-print-documents

# Razorpay Payment Gateway (Test mode credentials for dev)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId1234
RAZORPAY_KEY_SECRET=your_test_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Google Gemini API (Multimodal Document Understanding & JSON Extraction)
GEMINI_API_KEY=your-gemini-api-key-here

# Printer Agent Authentication
PRINT_AGENT_SHARED_SECRET=your-secure-random-agent-shared-secret-min-32-chars

# CORS Origin (comma-separated or single URL)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security & Sessions
JWT_SECRET=your-fallback-jwt-signing-secret-for-sessions-min-32-chars
QR_SESSION_TTL_MINUTES=15
IDEMPOTENCY_TTL_SECONDS=86400
